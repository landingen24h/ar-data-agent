--- /dev/null
+++ b/qualifier/Q5/split.test.ts
@@ -0,0 +1,71 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { splitFees } from './split.js';
+
+// A1: Throws on negative total
+test('A1', () => {
+  assert.throws(() => splitFees(-1n, [100]), /negative total/);
+});
+
+// A2: Throws on bad shares (empty, non-integer, negative)
+test('A2', () => {
+  assert.throws(() => splitFees(100n, []), /bad shares/);
+  assert.throws(() => splitFees(100n, [50.5, 49.5]), /bad shares/);
+  assert.throws(() => splitFees(100n, [50, -50]), /bad shares/);
+});
+
+// A3: Throws when shares do not sum to 100
+test('A3', () => {
+  assert.throws(() => splitFees(100n, [60, 30]), /shares must sum to 100/);
+});
+
+// A4: Correct distribution without remainder
+test('A4', () => {
+  const total = 1000n;
+  const shares = [50, 30, 20];
+  const result = splitFees(total, shares);
+  assert.deepEqual(result, [500n, 300n, 200n]);
+  const sum = result.reduce((a, b) => a + b, 0n);
+  assert.equal(sum, total);
+});
+
+// A5: Distribution with remainder added to first share
+test('A5', () => {
+  const total = 1001n;
+  const shares = [33, 33, 34];
+  const result = splitFees(total, shares);
+  assert.deepEqual(result, [331n, 330n, 340n]);
+  const sum = result.reduce((a, b) => a + b, 0n);
+  assert.equal(sum, total);
+});
+
+// A6: Zero total yields zero allocations
+test('A6', () => {
+  const total = 0n;
+  const shares = [0, 0, 100];
+  const result = splitFees(total, shares);
+  assert.deepEqual(result, [0n, 0n, 0n]);
+});
+
+// A7: Handles very large totals correctly
+test('A7', () => {
+  const total = 2n ** 100n; // large bigint
+  const shares = [70, 30];
+  const result = splitFees(total, shares);
+  const out0 = (total * 70n) / 100n;
+  const out1 = (total * 30n) / 100n;
+  const remainder = total - (out0 + out1);
+  const expected = [out0 + remainder, out1];
+  assert.deepEqual(result, expected);
+  const sum = result.reduce((a, b) => a + b, 0n);
+  assert.equal(sum, total);
+});
+
+// A8: Function is idempotent for same inputs
+test('A8', () => {
+  const total = 12345n;
+  const shares = [40, 60];
+  const first = splitFees(total, shares);
+  const second = splitFees(total, shares);
+  assert.deepEqual(first, second);
+});

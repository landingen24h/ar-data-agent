+export function plainAmount(value: string, decimals: number, symbol: string): string {
+  // Validate types
+  if (typeof value !== "string") {
+    throw new Error("value must be a string");
+  }
+  if (typeof decimals !== "number" || !Number.isInteger(decimals) || decimals < 0) {
+    throw new Error("decimals must be a non‑negative integer");
+  }
+  if (typeof symbol !== "string" || symbol.length === 0) {
+    throw new Error("symbol must be a non‑empty string");
+  }
+
+  // Normalize Arabic-Indic and Eastern Arabic-Indic digits to Latin digits
+  const normalizeDigits = (s: string): string =>
+    s.replace(/[\u0660-\u0669\u06F0-\u06F9]/g, (c) => {
+      const code = c.charCodeAt(0);
+      if (code >= 0x660 && code <= 0x669) {
+        // Arabic-Indic
+        return String.fromCharCode(0x30 + (code - 0x660));
+      }
+      if (code >= 0x6f0 && code <= 0x6f9) {
+        // Eastern Arabic-Indic
+        return String.fromCharCode(0x30 + (code - 0x6f0));
+      }
+      return c;
+    });
+
+  const norm = normalizeDigits(value);
+
+  // Validate sign and digits
+  const signMatch = /^(-)?(\d+)$/.exec(norm);
+  if (!signMatch) {
+    throw new Error("value must be an integer string, optional leading minus");
+  }
+  const isNegative = !!signMatch[1];
+  const digits = signMatch[2];
+
+  // Convert to BigInt
+  const absBig = BigInt(digits);
+
+  // Compute divisor 10^decimals
+  const divisor = BigInt(10) ** BigInt(decimals);
+
+  const integerPart = absBig / divisor;
+  const fractionPart = absBig % divisor;
+
+  // Integer part with commas
+  const intStrRaw = integerPart.toString();
+  const intStr = intStrRaw.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
+
+  // Fraction string handling
+  let fractionStr = fractionPart.toString().padStart(decimals, "0");
+
+  // Ensure at least two decimal digits regardless of token decimals
+  if (decimals < 2) {
+    fractionStr = fractionStr.padEnd(2, "0");
+  }
+
+  // Trim trailing zeros beyond the required minimum of two digits
+  while (fractionStr.length > 2 && fractionStr.endsWith("0")) {
+    fractionStr = fractionStr.slice(0, -1);
+  }
+
+  // If decimals is zero, fractionStr will be empty after padding; ensure two zeros
+  if (decimals === 0) {
+    fractionStr = "00";
+  }
+
+  const numberFormatted = `${intStr}.${fractionStr}`;
+
+  if (isNegative && absBig !== BigInt(0)) {
+    return `minus ${numberFormatted} ${symbol}`;
+  }
+  return `${numberFormatted} ${symbol}`;
+}
diff --git a/qualifier/Q1/plain-amount.test.ts b/qualifier/Q1/plain-amount.test.ts

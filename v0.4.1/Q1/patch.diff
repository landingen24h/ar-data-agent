--- /dev/null
+++ b/qualifier/Q1/plain-amount.test.ts
@@ -0,0 +1,31 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { plainAmount } from "./plain-amount.js";
+
+test("A1: formats positive value with grouping and trimming", () => {
+  const result = plainAmount("1234567890", 6, "USDC");
+  assert.equal(result, "1,234.56789 USDC");
+});
+
+test("A2: decimals zero pads to two", () => {
+  const result = plainAmount("5", 0, "USDC");
+  assert.equal(result, "5.00 USDC");
+});
+
+test("A3: negative value formatting", () => {
+  const result = plainAmount("-123456", 2, "USDC");
+  assert.equal(result, "minus 1,234.56 USDC");
+});
+
+test("A4: Arabic Indic digits conversion", () => {
+  const result = plainAmount("١٢٣٤٥٦", 2, "USDC");
+  assert.equal(result, "1,234.56 USDC");
+});
+
+test("A5: invalid inputs throw", () => {
+  assert.throws(() => plainAmount("12a34", 2, "USDC"));
+  assert.throws(() => plainAmount("-12-34", 2, "USDC"));
+  assert.throws(() => plainAmount("123", -1, "USDC"));
+  assert.throws(() => plainAmount("123", 2.5, "USDC"));
+  assert.throws(() => plainAmount(123 as any, 2, "USDC"));
+});

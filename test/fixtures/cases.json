[
  { "name": "E1 all five chambers pass and a token is issued", "expect": { "ok": true } },
  { "name": "E2 identity: signed by a stranger", "identitySigner": "stranger", "expect": { "stoppedAt": "identity", "reason": "wrong_signer" } },
  { "name": "E3 identity: listing changed after signing", "postSign": { "challenge.listingId": "lax-ext-other" }, "expect": { "stoppedAt": "identity", "reason": "wrong_signer" } },
  { "name": "E4 identity: signature is not 65 bytes", "postSign": { "identitySignature": "0x1234" }, "expect": { "stoppedAt": "identity", "reason": "malformed_signature" } },
  { "name": "E5 identity: challenge expired", "nowOffsetMs": 300000, "expect": { "stoppedAt": "identity", "reason": "expired" } },
  { "name": "E6 identity: challenge from the future", "nowOffsetMs": -1, "expect": { "stoppedAt": "identity", "reason": "not_yet_valid" } },
  { "name": "E7 identity: the same signed challenge twice", "runTwice": true, "expect": { "stoppedAt": "identity", "reason": "replayed_nonce" } },
  { "name": "E8 trust: no accepted delivery and no admission test", "patch": { "record": { "listing_age_days": 400, "aiax_ready": true } }, "expect": { "stoppedAt": "trust", "reason": "below_min_tier" } },
  { "name": "E9 trust: mostly rejected deliveries", "patch": { "record": { "accepted_deliveries": 1, "rejected_deliveries": 9 } }, "expect": { "stoppedAt": "trust", "reason": "below_min_tier" } },
  { "name": "E10 trust: a high outside score cannot lift an unproven agent", "patch": { "record": {}, "outside": { "score": 100, "weight": 1, "source": "fixture" } }, "expect": { "stoppedAt": "trust", "reason": "below_min_tier" } },
  { "name": "E11 intent: another job id", "patch": { "intent.job_id": "00000000-0000-0000-0000-000000000000" }, "expect": { "stoppedAt": "intent", "reason": "wrong_job" } },
  { "name": "E12 intent: price over the ceiling", "patch": { "intent.price_usdc": 40.01 }, "expect": { "stoppedAt": "intent", "reason": "over_ceiling" } },
  { "name": "E13 intent: price zero", "patch": { "intent.price_usdc": 0 }, "expect": { "stoppedAt": "intent", "reason": "bad_price" } },
  { "name": "E14 intent: Solana settlement on a Base only job", "patch": { "intent.settlement_chain": "solana" }, "expect": { "stoppedAt": "intent", "reason": "chain_not_offered" } },
  { "name": "E15 intent: bid after the window closed", "patch": { "job.bid_closes": "2026-10-26T12:00:00.000Z" }, "expect": { "stoppedAt": "intent", "reason": "window_closed" } },
  { "name": "E16 intent: delivery after the job deadline", "patch": { "intent.delivery_by": "2026-10-29T00:00:00.000Z" }, "expect": { "stoppedAt": "intent", "reason": "late_delivery" } },
  { "name": "E17 intent: bid on a job already selected", "patch": { "job.status": "selected" }, "expect": { "stoppedAt": "intent", "reason": "job_not_open" } },
  { "name": "E18 intent: deliver on a job that is still open", "patch": { "intent.action": "deliver" }, "expect": { "stoppedAt": "intent", "reason": "action_not_allowed" } },
  { "name": "E19 intent: no intent at all", "patch": { "intent": null }, "expect": { "stoppedAt": "intent", "reason": "malformed_intent" } },
  { "name": "E20 soul: another SOUL document", "patch": { "handshake.soul_sha256": "other" }, "expect": { "stoppedAt": "soul", "reason": "soul_mismatch" } },
  { "name": "E21 soul: only four laws accepted", "patch": { "handshake.laws_accepted": ["L1", "L2", "L3", "L4"] }, "expect": { "stoppedAt": "soul", "reason": "laws_incomplete" } },
  { "name": "E22 soul: handshake bound to another session", "patch": { "handshake.nonce": "cd" }, "expect": { "stoppedAt": "soul", "reason": "nonce_mismatch" } },
  { "name": "E23 soul: handshake signed by a stranger", "soulSigner": "stranger", "expect": { "stoppedAt": "soul", "reason": "wrong_signer" } },
  { "name": "E24 soul: DID swapped after signing", "postSign": { "handshake.did": "did:pkh:eip155:8453:0x0000000000000000000000000000000000000001" }, "expect": { "stoppedAt": "soul", "reason": "malformed_handshake" } },
  { "name": "E25 session: secret too short to issue", "patch": { "ctx.sessionSecret": "short" }, "expect": { "stoppedAt": "session", "reason": "issue_failed" } },
  { "name": "E26 session: lifetime over one hour", "patch": { "ctx.sessionTtlMs": 3600001 }, "expect": { "stoppedAt": "session", "reason": "issue_failed" } }
]

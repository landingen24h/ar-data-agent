[
  { "name": "T1 token verifies just before expiry", "verifyAtOffsetMs": 899999, "expect": "ok" },
  { "name": "T2 token refused at expiry", "verifyAtOffsetMs": 900000, "expect": "expired" },
  { "name": "T3 token refused before it was issued", "verifyAtOffsetMs": -1, "expect": "not_yet_valid" },
  { "name": "T4 payload tampered to raise the tier", "tamper": "payload", "expect": "bad_signature" },
  { "name": "T5 MAC tampered", "tamper": "mac", "expect": "bad_signature" },
  { "name": "T6 checked with another secret", "secret": "another-session-secret-0123456789abcdef", "expect": "bad_signature" },
  { "name": "T7 not a token", "replace": "abc", "expect": "malformed_token" },
  { "name": "T8 three parts", "replace": "a.b.c", "expect": "malformed_token" }
]

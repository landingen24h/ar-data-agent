{
  "name": "lax-mcp-server",
  "version": "0.1.0",
  "description": "MCP server that gives any agent the LAX registry (lax.kognai.ai) as tools: search agents, get an offer, list jobs, get a job, submit work.",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js", "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "bin": { "lax-mcp": "bin/lax-mcp.js" },
  "files": ["dist", "src", "bin", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.test.json", "build": "tsc", "prepublishOnly": "npm run build && npm test"
  },
  "engines": { "node": ">=20" },
  "dependencies": { "@modelcontextprotocol/sdk": "1.32.1", "zod": "3.25.76" },
  "devDependencies": { "tsx": "4.20.6", "typescript": "5.6.3", "@types/node": "20.17.6" }
}

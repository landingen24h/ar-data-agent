{
  "name": "cerberus-e2e",
  "version": "0.1.0",
  "description": "End to end tests of the five Cerberus chambers (identity, trust score, intent, SOUL handshake, session token) driven in order from JSON fixtures, with no network.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "coverage": "node --import tsx --test --experimental-test-coverage test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": { "node": ">=20" },
  "dependencies": { "viem": "2.21.45" },
  "devDependencies": { "tsx": "4.20.6", "typescript": "5.6.3", "@types/node": "20.17.6" }
}
